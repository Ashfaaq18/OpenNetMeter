<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenNetMeter.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:ctrl="using:OpenNetMeter.Views.Controls"
             x:Class="OpenNetMeter.Views.MainWindowTabs.SummaryView"
             x:DataType="vm:SummaryViewModel"
             mc:Ignorable="d">
  <UserControl.Styles>
    <Style Selector="TextBlock.dayLabel">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextFaint}"/>
    </Style>
    <Style Selector="TextBlock.dayLabel.today">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextHeader}"/>
    </Style>
  </UserControl.Styles>

  <Grid Margin="12,8" RowDefinitions="*,110" ColumnDefinitions="180,12,*">
    <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,10,Auto,10,Auto">
      <Border Grid.Row="0" Padding="8" CornerRadius="12"
              Background="{DynamicResource BrushSurfacePanel}" BoxShadow="{DynamicResource ShadowStrong}">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Border CornerRadius="6" Padding="4" Width="18" Height="18"
                    Background="{DynamicResource BrushDownload}">
              <PathIcon Data="{DynamicResource IconClock}"
                        Foreground="{DynamicResource BrushWhite}" Width="12" Height="12"/>
            </Border>
            <TextBlock Text="Current Session" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextHeader}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
          </StackPanel>

          <ctrl:StatRow Header="DL" Value="{Binding CurrentSessionDownloadText}"
                        BackgroundBrush="{DynamicResource BrushDownload}"
                        IconData="{DynamicResource IconDownload}"/>
          <ctrl:StatRow Header="UL" Value="{Binding CurrentSessionUploadText}"
                        BackgroundBrush="{DynamicResource BrushUpload}"
                        IconData="{DynamicResource IconUpload}"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Padding="8" CornerRadius="12"
              Background="{DynamicResource BrushSurfacePanel}" BoxShadow="{DynamicResource ShadowStrong}">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal">
            <Border CornerRadius="6" Padding="4" Width="18" Height="18"
                    Background="{DynamicResource BrushUpload}">
              <PathIcon Data="{DynamicResource IconDatabase}"
                        Foreground="{DynamicResource BrushWhite}" Width="12" Height="12"/>
            </Border>
            <TextBlock Text="Usage From" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextHeader}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
          </StackPanel>

          <DatePicker MinWidth="0" Width="140" Height="30"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      SelectedDate="{Binding SinceDate, Mode=TwoWay}"/>

          <ctrl:StatRow Header="DL" Value="{Binding TotalFromDateDownloadText}"
                        BackgroundBrush="{DynamicResource BrushDownload}"
                        IconData="{DynamicResource IconDownload}"/>
          <ctrl:StatRow Header="UL" Value="{Binding TotalFromDateUploadText}"
                        BackgroundBrush="{DynamicResource BrushUpload}"
                        IconData="{DynamicResource IconUpload}"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Padding="8" CornerRadius="12"
              Background="{DynamicResource BrushSurfacePanel}" BoxShadow="{DynamicResource ShadowStrong}">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal">
            <Border CornerRadius="6" Padding="4" Width="18" Height="18"
                    Background="{DynamicResource BrushAccentPurple}">
              <PathIcon Data="{DynamicResource IconChartLine}"
                        Foreground="{DynamicResource BrushWhite}" Width="12" Height="12"/>
            </Border>
            <TextBlock Text="Weekly Trend" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushTextHeader}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding WeeklyTrend.TotalText}"
                       Foreground="{DynamicResource BrushTextBody}"
                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Grid.Column="1" CornerRadius="4" Padding="4,1"
                    Background="{DynamicResource BrushHeaderRow}"
                    IsVisible="{Binding WeeklyTrend.HasComparison}"
                    ToolTip.Tip="Compared with the previous 7 days">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <PathIcon Width="8" Height="8" VerticalAlignment="Center"
                          Foreground="{DynamicResource BrushTextSecondaryAlt}"
                          Data="{DynamicResource IconTrendDown}"
                          IsVisible="{Binding !WeeklyTrend.IsIncrease}"/>
                <PathIcon Width="8" Height="8" VerticalAlignment="Center"
                          Foreground="{DynamicResource BrushTextSecondaryAlt}"
                          Data="{DynamicResource IconTrendUp}"
                          IsVisible="{Binding WeeklyTrend.IsIncrease}"/>
                <TextBlock Text="{Binding WeeklyTrend.DeltaText}" FontSize="10"
                           Foreground="{DynamicResource BrushTextSecondaryAlt}"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>

          <ItemsControl ItemsSource="{Binding WeeklyTrend.Days}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WeeklyUsageDayViewModel">
                <Grid RowDefinitions="34,Auto" Margin="1,0" ToolTip.Tip="{Binding TooltipText}">
                  <Border Grid.Row="0" CornerRadius="3"
                          Background="{DynamicResource BrushHeaderRow}"/>
                  <Border Grid.Row="0" CornerRadius="3" ClipToBounds="True"
                          VerticalAlignment="Bottom" Height="{Binding TotalBarHeight}">
                    <StackPanel>
                      <Border Height="{Binding UploadBarHeight}"
                              Background="{DynamicResource BrushUpload}"/>
                      <Border Height="{Binding DownloadBarHeight}"
                              Background="{DynamicResource BrushDownload}"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Grid.Row="1" Text="{Binding DayLabel}"
                             Classes="dayLabel" Classes.today="{Binding IsToday}"
                             FontSize="9" Margin="0,3,0,0"
                             HorizontalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="0" Grid.Column="2" CornerRadius="12"
            Background="{DynamicResource BrushSurfacePanel}"
            BoxShadow="{DynamicResource ShadowStrong}"
            Margin="0,0,0,10" Padding="0" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="12,8"
                Background="{DynamicResource BrushHeaderRow}"
                BorderBrush="{DynamicResource BrushBorderEmphasis}"
                BorderThickness="0,0,0,0.4">
          <Grid>
            <StackPanel Orientation="Horizontal">
              <PathIcon Data="{DynamicResource IconBug}"
                        Foreground="{DynamicResource BrushIconMuted}" Width="16" Height="16"/>
              <TextBlock Text="Active Processes" Foreground="{DynamicResource BrushTextHeader}"
                         FontSize="12" FontWeight="SemiBold"
                         VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondaryAlt}" FontSize="10">
              <Run Text="{Binding ProcessCount}"/>
              <Run Text=" processes"/>
            </TextBlock>
          </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="3*,1.2*,1.2*,1.2*,1.2*" Margin="10,8,10,4">
            <ctrl:SortHeader Header="Name" SortKey="Name"
                             SortCommand="{Binding SortProcessesCommand}"
                             CurrentSortColumn="{Binding CurrentSortColumn}"
                             IsSortDescending="{Binding IsSortDescending}"/>
            <ctrl:SortHeader Grid.Column="1" Header="Current DL" SortKey="CurrentDownload"
                             SortCommand="{Binding SortProcessesCommand}"
                             CurrentSortColumn="{Binding CurrentSortColumn}"
                             IsSortDescending="{Binding IsSortDescending}"/>
            <ctrl:SortHeader Grid.Column="2" Header="Current UL" SortKey="CurrentUpload"
                             SortCommand="{Binding SortProcessesCommand}"
                             CurrentSortColumn="{Binding CurrentSortColumn}"
                             IsSortDescending="{Binding IsSortDescending}"/>
            <ctrl:SortHeader Grid.Column="3" Header="Total DL" SortKey="TotalDownload"
                             SortCommand="{Binding SortProcessesCommand}"
                             CurrentSortColumn="{Binding CurrentSortColumn}"
                             IsSortDescending="{Binding IsSortDescending}"/>
            <ctrl:SortHeader Grid.Column="4" Header="Total UL" SortKey="TotalUpload"
                             SortCommand="{Binding SortProcessesCommand}"
                             CurrentSortColumn="{Binding CurrentSortColumn}"
                             IsSortDescending="{Binding IsSortDescending}"/>
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="0,0,0,6">
            <ItemsControl ItemsSource="{Binding ActiveProcesses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="3*,1.2*,1.2*,1.2*,1.2*" Margin="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="4" MinWidth="0">
                      <Button Command="{Binding SearchProcessCommand}"
                              Background="Transparent" BorderThickness="0"
                              Padding="2" Cursor="Hand"
                              ToolTip.Tip="Search online">
                        <PathIcon Data="{DynamicResource IconSearch}"
                                  Width="12" Height="12"
                                  Foreground="{DynamicResource BrushTextSecondary}"/>
                      </Button>
                      <Image Source="{Binding Icon}" Width="16" Height="16"/>
                      <TextBlock Text="{Binding ProcessName}"
                                 Foreground="{DynamicResource BrushTextBody}"
                                 FontSize="11" TextWrapping="Wrap"
                                 MinWidth="0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentDownload}"
                               Foreground="{DynamicResource BrushTextBody}" FontSize="11" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="2" Text="{Binding CurrentUpload}"
                               Foreground="{DynamicResource BrushTextBody}" FontSize="11" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="3" Text="{Binding TotalDownload}"
                               Foreground="{DynamicResource BrushTextBody}" FontSize="11" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="4" Text="{Binding TotalUpload}"
                               Foreground="{DynamicResource BrushTextBody}" FontSize="11" VerticalAlignment="Top"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
            Padding="10" CornerRadius="12"
            Background="{DynamicResource BrushSurfacePanel}"
            BoxShadow="{DynamicResource ShadowStrong}">
      <lvc:CartesianChart Series="{Binding GraphSeries}"
                          Background="{DynamicResource BrushGraphBackground}"
                          XAxes="{Binding GraphXAxes}"
                          YAxes="{Binding GraphYAxes}"
                          ZoomMode="None"
                          TooltipPosition="Hidden"
                          AnimationsSpeed="00:00:00.150"/>
    </Border>
  </Grid>
</UserControl>
