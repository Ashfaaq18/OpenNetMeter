<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenNetMeter.ViewModels"
             x:Class="OpenNetMeter.Views.MainWindowTabs.SettingsView"
             x:DataType="vm:SettingsViewModel"
             mc:Ignorable="d">
  <UserControl.Styles>
    <!-- Each setting is a "*,Auto" row: title + hint on the left, control on the right. -->
    <Style Selector="TextBlock.settingTitle">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextBody}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.settingHint">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.rowDivider">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource BrushDivider}"/>
      <Setter Property="Margin" Value="0,12"/>
    </Style>
    <Style Selector="Border.settingsCard">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource BrushSurfacePanel}"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowSoft}"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.cardHeader">
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Background" Value="{DynamicResource BrushHeaderRow}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderEmphasis}"/>
      <Setter Property="BorderThickness" Value="0,0,0,0.4"/>
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="Foreground" Value="{DynamicResource BrushTextHeader}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.outlineBtn">
      <Setter Property="MinWidth" Value="110"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource BrushHeaderRow}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushTextUi}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderEmphasis}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16,6"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer Margin="12,8">
    <StackPanel Spacing="12">

      <!-- Row 1: General | Mini widget -->
      <Grid ColumnDefinitions="*,12,*">
        <Border Grid.Column="0" Classes="settingsCard">
          <StackPanel>
            <Border Classes="cardHeader">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border CornerRadius="6" Padding="4" Width="24" Height="24" Background="{DynamicResource BrushDownload}">
                  <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                            Foreground="{DynamicResource BrushWhite}" Width="14" Height="14"/>
                </Border>
                <TextBlock Text="General" Classes="cardTitle"/>
              </StackPanel>
            </Border>
            <StackPanel Margin="20,16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Start on Windows startup" Classes="settingTitle"/>
                  <TextBlock Text="Launch automatically when you sign in" Classes="settingHint"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              VerticalAlignment="Center" OnContent="" OffContent="" Margin="0,0,-8,0"/>
              </Grid>
              <Border Classes="rowDivider"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Minimize to tray on start" Classes="settingTitle"/>
                  <TextBlock Text="Start quietly in the system tray" Classes="settingHint"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeOnStart, Mode=TwoWay}"
                              IsEnabled="{Binding CanChangeMinimizeOnStart}"
                              VerticalAlignment="Center" OnContent="" OffContent="" Margin="0,0,-8,0"/>
              </Grid>
              <Border Classes="rowDivider"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Dark mode" Classes="settingTitle"/>
                  <TextBlock Text="Use the dark theme for the interface" Classes="settingHint"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DarkMode, Mode=TwoWay}"
                              VerticalAlignment="Center" OnContent="" OffContent="" Margin="0,0,-8,0"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="settingsCard">
          <StackPanel>
            <Border Classes="cardHeader">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border CornerRadius="6" Padding="4" Width="24" Height="24" Background="{DynamicResource BrushUpload}">
                  <PathIcon Data="M21,17H7V3H21M21,1H7A2,2 0 0,0 5,3V17A2,2 0 0,0 7,19H21A2,2 0 0,0 23,17V3A2,2 0 0,0 21,1M3,5H1V21A2,2 0 0,0 3,23H19V21H3V5Z"
                            Foreground="{DynamicResource BrushWhite}" Width="14" Height="14"/>
                </Border>
                <TextBlock Text="Mini widget" Classes="cardTitle"/>
              </StackPanel>
            </Border>
            <StackPanel Margin="20,16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Show mini widget" Classes="settingTitle"/>
                  <TextBlock Text="Floating overlay showing live speeds" Classes="settingHint"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MiniWidgetVisible, Mode=TwoWay}"
                              VerticalAlignment="Center" OnContent="" OffContent="" Margin="0,0,-8,0"/>
              </Grid>
              <Border Classes="rowDivider"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Transparency" Classes="settingTitle"/>
                  <TextBlock Text="0% is fully opaque" Classes="settingHint"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Slider Width="140" Minimum="0" Maximum="100" VerticalAlignment="Center"
                          IsSnapToTickEnabled="True" TickFrequency="1"
                          Value="{Binding MiniWidgetTransparency, Mode=TwoWay}"
                          IsEnabled="{Binding MiniWidgetVisible}"/>
                  <TextBlock MinWidth="34" TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{DynamicResource BrushTextSecondaryAlt}" FontSize="11">
                    <Run Text="{Binding MiniWidgetTransparency}"/><Run Text="%"/>
                  </TextBlock>
                </StackPanel>
              </Grid>
              <Border Classes="rowDivider"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Widget total" Classes="settingTitle"/>
                  <TextBlock Text="What the total in the widget counts" Classes="settingHint"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <RadioButton GroupName="WidgetTotal" Classes="pill"
                               IsChecked="{Binding IsMiniWidgetTotalSession, Mode=TwoWay}">
                    <TextBlock Text="This session"/>
                  </RadioButton>
                  <RadioButton GroupName="WidgetTotal" Classes="pill"
                               IsChecked="{Binding IsMiniWidgetTotalUsageFrom, Mode=TwoWay}">
                    <TextBlock Text="Since a date"/>
                  </RadioButton>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,10,0,0" IsVisible="{Binding IsMiniWidgetTotalUsageFrom}">
                <TextBlock Grid.Column="0" Text="Count usage from" Classes="settingHint" Margin="0" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="1" MinWidth="0" Width="220" Height="30" VerticalAlignment="Center"
                            SelectedDate="{Binding MiniWidgetUsageFromDate, Mode=TwoWay}"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 2: Network monitoring | History & data -->
      <Grid ColumnDefinitions="*,12,*">
        <Border Grid.Column="0" Classes="settingsCard">
          <StackPanel>
            <Border Classes="cardHeader">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border CornerRadius="6" Padding="4" Width="24" Height="24" Background="{DynamicResource BrushWarning}">
                  <PathIcon Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M4,12C4,11.39 4.08,10.79 4.21,10.22L8,14V15C8,16.1 8.9,17 10,17V19.93C6.61,19.44 4,16.07 4,12M17.9,17.39C17.64,16.58 16.9,16 16,16H15V13C15,12.45 14.55,12 14,12H8V10H10C10.55,10 11,9.55 11,9V7H13C14.1,7 15,6.1 15,5V4.59C17.93,5.77 20,8.64 20,12C20,14.08 19.2,15.97 17.9,17.39Z"
                            Foreground="{DynamicResource BrushWhite}" Width="14" Height="14"/>
                </Border>
                <TextBlock Text="Network monitoring" Classes="cardTitle"/>
              </StackPanel>
            </Border>
            <StackPanel Margin="20,16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Network adapter" Classes="settingTitle"/>
                  <TextBlock Text="Pin an adapter, like a VPN, to count only its traffic"
                             Classes="settingHint"
                             ToolTip.Tip="Automatic follows the connection Windows uses for internet traffic. A pinned adapter is measured on its own, and nothing is counted while it is disconnected."/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center"
                          ItemsSource="{Binding AdapterChoices}"
                          SelectedItem="{Binding SelectedAdapterChoice, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AdapterChoice">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Label}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,8,0,0"
                    IsVisible="{Binding IsPinnedAdapterMissing}">
                <PathIcon Grid.Column="0" Width="11" Height="11" VerticalAlignment="Top" Margin="0,1,0,0"
                          Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"
                          Foreground="{DynamicResource BrushWarning}"/>
                <TextBlock Grid.Column="1" Text="Not connected. Nothing is being counted until it reconnects or you choose Automatic."
                           FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushWarning}"/>
              </Grid>
              <Border Classes="rowDivider"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Networks to monitor" Classes="settingTitle"/>
                  <TextBlock Text="Choose Public for internet-only traffic" Classes="settingHint"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <RadioButton GroupName="NetTarget" Classes="pill"
                               IsChecked="{Binding IsNetworkTargetPrivate, Mode=TwoWay}">
                    <TextBlock Text="Private"/>
                  </RadioButton>
                  <RadioButton GroupName="NetTarget" Classes="pill"
                               IsChecked="{Binding IsNetworkTargetPublic, Mode=TwoWay}">
                    <TextBlock Text="Public"/>
                  </RadioButton>
                  <RadioButton GroupName="NetTarget" Classes="pill"
                               IsChecked="{Binding IsNetworkTargetBoth, Mode=TwoWay}">
                    <TextBlock Text="Both"/>
                  </RadioButton>
                </StackPanel>
              </Grid>
              <Border Classes="rowDivider"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Speed format" Classes="settingTitle"/>
                  <TextBlock Text="Magnitude and unit for live speeds" Classes="settingHint"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ComboBox Width="84" ItemsSource="{Binding SpeedMagnitudes}"
                            ToolTip.Tip="Magnitude"
                            SelectedIndex="{Binding SelectedSpeedMagnitudeIndex, Mode=TwoWay}"/>
                  <ComboBox Width="140" ItemsSource="{Binding SpeedUnits}"
                            ToolTip.Tip="Unit"
                            SelectedIndex="{Binding SelectedSpeedUnitIndex, Mode=TwoWay}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="settingsCard">
          <StackPanel>
            <Border Classes="cardHeader">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border CornerRadius="6" Padding="4" Width="24" Height="24" Background="{DynamicResource BrushDangerBright}">
                  <PathIcon Data="M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z"
                            Foreground="{DynamicResource BrushWhite}" Width="14" Height="14"/>
                </Border>
                <TextBlock Text="History &amp; data" Classes="cardTitle"/>
              </StackPanel>
            </Border>
            <StackPanel Margin="20,16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="History retention" Classes="settingTitle"/>
                  <TextBlock Text="How long daily usage is kept" Classes="settingHint"/>
                </StackPanel>
                <ComboBox Grid.Column="1" MinWidth="110" VerticalAlignment="Center"
                          ItemsSource="{Binding RetentionOptions}"
                          SelectedIndex="{Binding SelectedRetentionIndex, Mode=TwoWay}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,8,0,0"
                    IsVisible="{Binding IsForeverRetentionSelected}">
                <PathIcon Grid.Column="0" Width="11" Height="11" VerticalAlignment="Top" Margin="0,1,0,0"
                          Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"
                          Foreground="{DynamicResource BrushWarning}"/>
                <TextBlock Grid.Column="1" Text="{Binding ForeverRetentionWarning}" FontSize="10" TextWrapping="Wrap"
                           Foreground="{DynamicResource BrushWarning}"/>
              </Grid>
              <Border Classes="rowDivider"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Export usage data" Classes="settingTitle"/>
                  <TextBlock Text="Save all stored history as CSV, JSON or HTML" Classes="settingHint"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="outlineBtn" Command="{Binding ExportAllCommand}">
                  <TextBlock Text="Export..."/>
                </Button>
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6" Margin="0,8,0,0"
                    IsVisible="{Binding ExportStatus.IsVisible}">
                <Panel Grid.Column="0" VerticalAlignment="Center">
                  <PathIcon Width="11" Height="11"
                            Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                            Foreground="{DynamicResource BrushDownload}"
                            IsVisible="{Binding ExportStatus.IsSuccess}"/>
                  <PathIcon Width="11" Height="11"
                            Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                            Foreground="{DynamicResource BrushDangerBright}"
                            IsVisible="{Binding ExportStatus.IsError}"/>
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding ExportStatus.Message}" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextSecondaryAlt}"/>
                <TextBlock Grid.Column="2" Text="{Binding ExportStatus.FileName}" FontSize="10" VerticalAlignment="Center"
                           TextTrimming="PrefixCharacterEllipsis"
                           Foreground="{DynamicResource BrushTextSecondaryAlt}"
                           ToolTip.Tip="{Binding ExportStatus.FilePath}"/>
                <Button Grid.Column="3" Classes="linkBtn" VerticalAlignment="Center"
                        Command="{Binding ExportStatus.RevealCommand}"
                        IsVisible="{Binding ExportStatus.CanReveal}">
                  <TextBlock Text="Open folder" FontSize="10" Foreground="{DynamicResource BrushLink}" TextDecorations="Underline"/>
                </Button>
              </Grid>
              <Border Classes="rowDivider"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Delete usage history" Classes="settingTitle" Foreground="{DynamicResource BrushDangerBright}"/>
                  <TextBlock Text="Removes every saved record. This can't be undone." Classes="settingHint"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="outlineBtn" Command="{Binding ResetDataCommand}"
                        Background="{DynamicResource BrushDangerBgSoft}"
                        BorderBrush="{DynamicResource BrushDangerBright}"
                        Foreground="{DynamicResource BrushDangerBright}">
                  <TextBlock Text="Delete all..." FontWeight="SemiBold"/>
                </Button>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 3: version, links and updates -->
      <Border Classes="settingsCard" Padding="20,12">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="16">
          <PathIcon Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                    Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                    Foreground="{DynamicResource BrushTextSecondaryAlt}"/>
          <TextBlock Grid.Column="1" Foreground="{DynamicResource BrushTextBody}" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center">
            <Run Text="OpenNetMeter "/><Run Text="{Binding VersionText}"/>
          </TextBlock>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button Classes="linkBtn" Command="{Binding OpenRepositoryCommand}">
              <TextBlock Text="GitHub" FontSize="11" Foreground="{DynamicResource BrushLink}" TextDecorations="Underline"/>
            </Button>
            <Button Classes="linkBtn" Command="{Binding OpenPrivacyPolicyCommand}">
              <TextBlock Text="Privacy policy" FontSize="11" Foreground="{DynamicResource BrushLink}" TextDecorations="Underline"/>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="{Binding UpdateStatusMessage}" Foreground="{DynamicResource BrushTextSecondaryAlt}" FontSize="11"
                       TextAlignment="Right" TextWrapping="Wrap"
                       IsVisible="{Binding UpdateStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <ProgressBar IsVisible="{Binding IsCheckingForUpdates}" IsIndeterminate="True" Height="3" MinWidth="120"/>
          </StackPanel>
          <Grid Grid.Column="4" VerticalAlignment="Center">
            <Button Classes="outlineBtn" Command="{Binding CheckForUpdatesCommand}"
                    IsVisible="{Binding !IsUpdateAvailable}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                          Foreground="{DynamicResource BrushTextSecondaryAlt}" Width="14" Height="14"/>
                <TextBlock Text="Check for updates"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding DownloadUpdateCommand}"
                    IsVisible="{Binding IsUpdateAvailable}"
                    HorizontalContentAlignment="Center"
                    Background="{DynamicResource BrushDownload}" Foreground="{DynamicResource BrushWhite}" Padding="16,6" CornerRadius="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"
                          Foreground="{DynamicResource BrushWhite}" Width="14" Height="14"/>
                <TextBlock Text="Download update" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
